# Copy to .env.local and fill in values. Never commit secrets.

NEXT_PUBLIC_SITE_URL=https://artzens.com
NEXT_PUBLIC_WHATSAPP_PHONE=923315856777

# Shopify Basic-plan checkout redirect (required)
# Cart stays on Artzens; checkout opens https://STORE/cart/VARIANT:QTY
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=store.artzens.com

# Optional — Storefront API / Headless channel (not needed for cart permalink)
# NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
# NEXT_PUBLIC_SHOPIFY_API_VERSION=2025-01

# Shopify Admin (scripts only). Use *.myshopify.com host for Admin API:
SHOPIFY_STORE_DOMAIN=wx0c1x-mp.myshopify.com
SHOPIFY_ADMIN_TOKEN=
# ARTZENS_IMAGE_BASE_URL=https://artzens.com
